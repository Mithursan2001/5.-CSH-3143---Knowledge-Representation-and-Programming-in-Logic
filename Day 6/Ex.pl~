father(a,b).
father(a,c).
father(b,d).
father(b,e).
father(c,f).

brother(X,Y) :- father(F,X), father(F,Y), X \= Y.

cousin(X,Y) :-father(F1,X),father(F2,Y),brother(F1,F2).

grandson(X,Y) :-father(Y,Z),father(Z,X).

descendent(X,Y) :-father(Y,X).
descendent(X,Y) :-father(Y,Z),descendent(X,Z).


