% Exercise 3.2
square(N, _) :-print_rows(N, N).

print_rows(_, 0) :- !.
print_rows(N, Count) :-print_stars(N),nl,Next is Count - 1,print_rows(N, Next).

print_stars(0) :- !.
print_stars(N) :-write('* '),Next is N - 1,print_stars(Next).

