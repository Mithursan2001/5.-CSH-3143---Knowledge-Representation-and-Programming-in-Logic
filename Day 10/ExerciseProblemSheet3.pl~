% Exercise3.11
poly_sum(P1, P2, Sum) :-
    append(P1, P2, P),         combine_terms(P, Sum).

combine_terms([], []).
combine_terms([(C,E)|T], [(C1,E)|Rest]) :-extract_exp(E, T, Cs, T1),sum_list([C|Cs], C1),C1 =\= 0,combine_terms(T1, Rest).
combine_terms([(0,_)|T], Rest) :-combine_terms(T, Rest).

extract_exp(_, [], [], []).
extract_exp(E, [(C1,E1)|T], [C1|Cs], Rest) :-E =:= E1,extract_exp(E, T, Cs, Rest).
extract_exp(E, [(C1,E1)|T], Cs, [(C1,E1)|Rest]) :-E =\= E1,extract_exp(E, T, Cs, Rest).

