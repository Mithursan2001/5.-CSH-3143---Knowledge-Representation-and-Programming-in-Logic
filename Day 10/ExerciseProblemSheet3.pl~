% Exercise3.13
goldbach(N, Solution) :-N > 2,0 is N mod 2,goldbach_pair(2, N, P1, P2),format(atom(Solution), '~w+~w', [P1,P2]).

goldbach_pair(P1, N, P1, P2) :-P1 =< N // 2,P2 is N - P1,prime(P1),prime(P2),!.
goldbach_pair(P1, N, X, Y) :-P1 =< N // 2,P1Next is P1 + 1,goldbach_pair(P1Next, N, X, Y).

