% Base cases
fibonacci(0, 0).
fibonacci(1, 1).

% Recursive case
fibonacci(N, F) :-
    N > 1,
    N1 is N - 1,
    N2 is N - 2,
    fibonacci(N1, F1),
    fibonacci(N2, F2),
    F is F1 + F2.


% fastfibo(N, F) computes the N-th Fibonacci number F efficiently.

fastfibo(N, F) :-
    fib_acc(N, 0, 1, F).

% fib_acc(N, A, B, F)
% A = Fib(0), B = Fib(1), counts up to N
fib_acc(0, A, _, A).
fib_acc(N, A, B, F) :-
    N > 0,
    N1 is N - 1,
    Sum is A + B,
    fib_acc(N1, B, Sum, F).

% element_at(List, Position, Element)
% Element is the item at index Position (1-based) in List.

% Base case: first element
element_at([H|_], 1, H).

% Recursive case: move down the list
element_at([_|T], N, X) :-
    N > 1,
    N1 is N - 1,
    element_at(T, N1, X).



% mean(List, Mean)
% Mean is the average of all elements in List.

mean(List, Mean) :-
    sum_list(List, Sum),
    length(List, Len),
    Len > 0,
    Mean is Sum / Len.

% sum_list(List, Sum) - helper predicate to sum elements of a list
sum_list([], 0).
sum_list([H|T], Sum) :-
    sum_list(T, SumTail),
    Sum is H + SumTail.



% minimum(List, Min)
% Min is the smallest element in List.

% Base case: list with one element
minimum([X], X).

% Recursive case: compare head with minimum of tail
minimum([H|T], Min) :-
    minimum(T, MinTail),
    (H < MinTail -> Min = H ; Min = MinTail).


% range(Start, End, List)
% List contains integers from Start to End (inclusive)

range(Start, End, []) :-
    Start > End.  % base case: empty list if Start > End

range(Start, End, [Start|Rest]) :-
    Start =< End,
    Next is Start + 1,
    range(Next, End, Rest).


