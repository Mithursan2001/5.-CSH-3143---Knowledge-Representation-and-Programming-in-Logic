% poly_sum(P1, P2, Sum)
% Sum is the polynomial representing P1 + P2

poly_sum(P1, P2, Sum) :-
    append(P1, P2, P),     % combine both polynomials
    combine_terms(P, Sum).

% combine_terms(List, Result)
% Combine terms with the same exponent
combine_terms([], []).
combine_terms([(C,E)|T], [(C1,E)|Rest]) :-
    % sum all coefficients with same exponent
    extract_exp(E, T, Cs, T1),
    sum_list([C|Cs], C1),
    C1 =\= 0,               % keep only non-zero coefficients
    combine_terms(T1, Rest).
combine_terms([(0,_)|T], Rest) :- % skip zero coefficients
    combine_terms(T, Rest).

% extract_exp(E, List, Coeffs, Remaining)
% Collect all coefficients with exponent E, return rest in Remaining
extract_exp(_, [], [], []).
extract_exp(E, [(C1,E1)|T], [C1|Cs], Rest) :-
    E =:= E1,
    extract_exp(E, T, Cs, Rest).
extract_exp(E, [(C1,E1)|T], Cs, [(C1,E1)|Rest]) :-
    E =\= E1,
    extract_exp(E, T, Cs, Rest).



% prime(N) succeeds if N is a prime number
prime(N) :-
    N > 1,
    \+ has_factor(N, 2).

% has_factor(N, F) succeeds if N has a factor F >= 2
has_factor(N, F) :-
    F * F =< N,
    ( N mod F =:= 0
    ; F2 is F + 1,
      has_factor(N, F2)
    ).

% goldbach(N, Solution) succeeds if Solution is a sum of two primes that equals N
goldbach(N, Solution) :-
    N > 2,
    0 is N mod 2,            % N must be even
    goldbach_pair(2, N, P1, P2),
    format(atom(Solution), '~w+~w', [P1,P2]).

% goldbach_pair(P1, N, P1, P2) finds two primes P1 and P2 such that P1 + P2 = N
goldbach_pair(P1, N, P1, P2) :-
    P1 =< N // 2,
    P2 is N - P1,
    prime(P1),
    prime(P2), !.
goldbach_pair(P1, N, X, Y) :-
    P1 =< N // 2,
    P1Next is P1 + 1,
    goldbach_pair(P1Next, N, X, Y).

