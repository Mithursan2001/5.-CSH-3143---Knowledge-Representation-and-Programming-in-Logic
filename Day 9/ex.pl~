% status(Commands, Position, Orientation)
% Computes the final position and orientation after executing Commands.
status(Commands, Position, Orientation) :-
    % initial position (0,0) and orientation north
    status(Commands, (0,0), north, Position, Orientation).

% Base case: no commands left
status([], Pos, Ori, Pos, Ori).

% Command: move forward
status([move|T], (X,Y), Ori, FinalPos, FinalOri) :-
    move_forward((X,Y), Ori, NewPos),
    status(T, NewPos, Ori, FinalPos, FinalOri).

% Command: turn right
status([right|T], Pos, Ori, FinalPos, FinalOri) :-
    turn_right(Ori, NewOri),
    status(T, Pos, NewOri, FinalPos, FinalOri).

% Command: turn left
status([left|T], Pos, Ori, FinalPos, FinalOri) :-
    turn_left(Ori, NewOri),
    status(T, Pos, NewOri, FinalPos, FinalOri).

% Move forward according to orientation
move_forward((X,Y), north, (X,Y1)) :- Y1 is Y + 1.
move_forward((X,Y), south, (X,Y1)) :- Y1 is Y - 1.
move_forward((X,Y), east,  (X1,Y)) :- X1 is X + 1.
move_forward((X,Y), west,  (X1,Y)) :- X1 is X - 1.

